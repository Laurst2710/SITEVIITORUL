              <rect x="85" y="496" width="220" height="32" rx="4" fill="#fef9c3" stroke="#ca8a04" stroke-width="1.8" />
              <text x="195" y="516" text-anchor="middle" fill="#713f12">divizorCandidat = divizorCandidat + 1</text>

              <line x1="85" y1="512" x2="14" y2="512" stroke="#4c1d95" stroke-width="1.6" />
              <line x1="14" y1="512" x2="14" y2="180" stroke="#4c1d95" stroke-width="1.6" />
              <line x1="14" y1="180" x2="195" y2="180" stroke="#4c1d95" stroke-width="1.6" marker-end="url(#arrow)" />

              <polygon points="105,557 295,557 275,593 85,593" fill="#dcfce7" stroke="#16a34a" stroke-width="1.8" />
              <text x="190" y="579" text-anchor="middle" font-weight="600" fill="#14532d">Ieșire sumaDivizoriImpari</text>
              <line x1="190" y1="593" x2="190" y2="618" stroke="#4c1d95" stroke-width="1.6" marker-end="url(#arrow)" />

              <rect x="130" y="618" width="120" height="34" rx="17" fill="#ddd6fe" stroke="#6d28d9" stroke-width="2" />
