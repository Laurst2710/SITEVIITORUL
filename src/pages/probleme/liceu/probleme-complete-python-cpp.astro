    <script>
    // Registrul problemelor publicate (sursa unica pentru contoare si cautarea dupa numar)
    const PROBLEME_INDEX = [
      
      {
        numar: '1360',
        titlu: 'Suma Gauss',
        subcat: 'sume-produse-numarari',
        capitol: 'Stația 1 · Sume, produse, numărări',
        url: '/probleme/pbinfo-1360-suma-gauss'
      },{
        numar: '387',
        titlu: 'Suma Divizorilor Impari',
        subcat: 'divizibilitate',
        capitol: 'Stația 1 · Divizibilitate',
        url: '/probleme/pbinfo-387-suma-divizorilor-impari'
      }
    ];

    // 1. Calculam si afisam automat contoarele pe fiecare subcategorie
    document.querySelectorAll('[data-subcat]').forEach((item) => {
      const subcat = item.getAttribute('data-subcat');
      const total = PROBLEME_INDEX.filter((p) => p.subcat === subcat).length;
      const pill = item.querySelector('[data-role="probleme-count"]');
      const dot = item.querySelector('.dot-active');

      if (pill) {
        const label = total === 1 ? 'problemă' : 'probleme';
        pill.innerHTML = `<strong>${total}</strong> ${label}`;
        if (total > 0) {
          pill.classList.add('active');
          item.classList.add('has-content');
        }
      }
      if (dot) {
        dot.style.display = total > 0 ? 'inline-block' : 'none';
      }
    });

    // 2. Cautarea rapida dupa numar
    const searchInput = document.getElementById('problemNumSearch');
    const searchBtn = document.getElementById('problemSearchBtn');
    const searchResult = document.getElementById('problemSearchResult');

    function cautaProblema(navigateDirect = false) {
      if (!searchInput || !searchResult) return;
      const query = searchInput.value.replace(/[^0-9]/g, '').trim();

      if (!query) {
        searchResult.innerHTML = '';
        return;
      }

      const potriviri = PROBLEME_INDEX.filter((p) => p.numar.startsWith(query));
      const exacta = PROBLEME_INDEX.find((p) => p.numar === query);

      if (navigateDirect && exacta) {
        window.location.href = exacta.url;
        return;
      }

      if (potriviri.length === 0) {
        searchResult.textContent = `Problema #${query} nu este încă publicată.`;
        return;
      }

      searchResult.innerHTML = potriviri
        .map((p) => `<a href="${p.url}">#${p.numar} — ${p.titlu} (${p.capitol}) →</a>`)
        .join(' ');
    }

    searchInput?.addEventListener('input', () => cautaProblema(false));
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        cautaProblema(true);
      }
    });
    searchBtn?.addEventListener('click', () => cautaProblema(true));
  </script>
