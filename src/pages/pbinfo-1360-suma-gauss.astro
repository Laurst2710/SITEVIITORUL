  <script>
    // Referinta catre zona in care elevul scrie codul Python
    const pyEditor = document.getElementById('pyEditor');
    // Referinta catre campul de intrare din bara de rulare
    const pyStdin = document.getElementById('pyStdin');
    // Referinta catre consola unde se afiseaza rezultatul
    const pyOutput = document.getElementById('pyOutput');
    // Referinta catre butonul "Rezolvare recomandata"
    const recBtn = document.getElementById('recSolutionBtn');
    // Referinta catre butonul "Copiaza codul"
    const copyPyBtn = document.getElementById('copyPyBtn');
    // Referinta catre containerul de intrare live de la tastatura
    const stdinLiveBox = document.getElementById('stdinLiveBox');
    // Referinta catre eticheta din caseta de intrare live
    const stdinLiveLabel = document.getElementById('stdinLiveLabel');
    // Referinta catre inputul in care se scrie valoarea
    const stdinLiveInput = document.getElementById('stdinLiveInput');
    // Referinta catre butonul "Trimite" din caseta de intrare live
    const stdinLiveSubmit = document.getElementById('stdinLiveSubmit');

    // Rezolvarea recomandata: citeste n prin input() fara sa hardcodeze nicio valoare
    const recommendedSolution = [
      '# Citim numarul n de la tastatura',
      'numarCitit = int(input())',
      '',
      '# Calculam suma 1 + 2 + ... + n prin formula lui Gauss',
      'sumaGauss = numarCitit * (numarCitit + 1) // 2',
      '',
      '# Afisam rezultatul',
      'print(sumaGauss)'
    ].join('\n');

    // Editorul porneste gol si editabil, fara solutie incarcata din start
    if (pyEditor) {
      pyEditor.value = '';
      pyEditor.readOnly = false;
      pyEditor.disabled = false;
      pyEditor.removeAttribute('readonly');
      pyEditor.removeAttribute('disabled');
    }

    // Campul de intrare ramane editabil de la tastatura
    if (pyStdin) {
      pyStdin.readOnly = false;
      pyStdin.disabled = false;
      pyStdin.removeAttribute('readonly');
      pyStdin.removeAttribute('disabled');
    }

    // Durata de asteptare (30s) pana la deblocarea butonului "Rezolvare recomandata"
    const unlockDelaySeconds = 30;
    // Numarul de secunde ramase in cronometru
    let remainingSeconds = unlockDelaySeconds;

    if (recBtn) {
      // Butonul incepe dezactivat (greyed)
      recBtn.disabled = true;
      // Afisam numarul initial de secunde pe buton
      recBtn.textContent = `Rezolvare recomandată (${remainingSeconds}s)`;

      // Actualizam cronometrul la fiecare secunda
      const timerId = setInterval(() => {
        remainingSeconds -= 1;
        if (remainingSeconds > 0) {
          recBtn.textContent = `Rezolvare recomandată (${remainingSeconds}s)`;
        } else {
          clearInterval(timerId);
          recBtn.disabled = false;
          recBtn.textContent = 'Rezolvare recomandată';
        }
      }, 1000);

      // Incarcam rezolvarea recomandata doar cand butonul este deblocat si apasat
      recBtn.addEventListener('click', () => {
        if (recBtn.disabled || !pyEditor) return;
        pyEditor.value = recommendedSolution;
        pyEditor.focus();
        pyOutput.style.color = '#a7f3d0';
        pyOutput.textContent = 'Rezolvare recomandată încărcată în editor (intrarea se ia de la tastatură, fără valoare hardcodată).';
      });
    }

    // Copierea codului C++ in clipboard
    document.getElementById('copyCppBtn')?.addEventListener('click', function () {
      const code = document.getElementById('cppCode')?.innerText || '';
      navigator.clipboard?.writeText(code).then(() => {
        this.textContent = 'Copiat!';
        setTimeout(() => { this.textContent = 'Copiază codul C++'; }, 1500);
      });
    });

    // Copierea codului Python din editor in clipboard
    copyPyBtn?.addEventListener('click', function () {
      const code = pyEditor ? pyEditor.value : '';
      if (!code) return;
      navigator.clipboard?.writeText(code).then(() => {
        const prev = this.textContent;
        this.textContent = 'Copiat!';
        setTimeout(() => { this.textContent = prev; }, 1500);
      });
    });

    // Golirea editorului Python si a consolei la cerere
    document.getElementById('clearPyBtn')?.addEventListener('click', () => {
      pyEditor.value = '';
      pyOutput.style.color = '#a7f3d0';
      pyOutput.textContent = '';
      pyEditor.focus();
    });

    // Preluarea unei valori de la tastatura atunci cand programul Python apeleaza input()
    function requestKeyboardInput(promptText) {
      return new Promise((resolve) => {
        if (!stdinLiveBox || !stdinLiveInput || !stdinLiveSubmit) {
          resolve(pyStdin ? pyStdin.value : '');
          return;
        }

        if (stdinLiveLabel) {
          stdinLiveLabel.textContent = promptText && promptText.trim()
            ? promptText.trim() + ' '
            : 'Introdu valoarea de la tastatură:';
        }

        stdinLiveInput.value = '';
        stdinLiveBox.classList.add('active');
        stdinLiveInput.focus();

        const cleanup = () => {
          stdinLiveBox.classList.remove('active');
          stdinLiveSubmit.removeEventListener('click', onSubmit);
          stdinLiveInput.removeEventListener('keydown', onKeyDown);
        };

        const onSubmit = () => {
          const val = stdinLiveInput.value;
          if (pyStdin) pyStdin.value = val;
          cleanup();
          resolve(val);
        };

        const onKeyDown = (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            onSubmit();
          }
        };

        stdinLiveSubmit.addEventListener('click', onSubmit);
        stdinLiveInput.addEventListener('keydown', onKeyDown);
      });
    }

        // Incarca dinamic Skulpt (cu fallback unpkg daca jsdelivr nu raspunde)
    function loadSkulptIfNeeded(timeoutMs = 3500) {
      return new Promise((resolve) => {
        if (typeof Sk !== 'undefined') {
          resolve(true);
          return;
        }

        const sources = [
          [
            'https://cdn.jsdelivr.net/npm/skulpt@1.2.0/dist/skulpt.min.js',
            'https://cdn.jsdelivr.net/npm/skulpt@1.2.0/dist/skulpt-stdlib.js'
          ],
          [
            'https://unpkg.com/skulpt@1.2.0/dist/skulpt.min.js',
            'https://unpkg.com/skulpt@1.2.0/dist/skulpt-stdlib.js'
          ]
        ];

        const tryPair = (idx) => {
          if (idx >= sources.length) {
            resolve(typeof Sk !== 'undefined');
            return;
          }

          const [coreUrl, stdlibUrl] = sources[idx];
          const s1 = document.createElement('script');
          s1.src = coreUrl;
          s1.async = true;

          s1.onload = () => {
            const s2 = document.createElement('script');
            s2.src = stdlibUrl;
            s2.async = true;
            s2.onload = () => resolve(typeof Sk !== 'undefined');
            s2.onerror = () => tryPair(idx + 1);
            document.head.appendChild(s2);
          };

          s1.onerror = () => tryPair(idx + 1);
          document.head.appendChild(s1);
        };

        const timer = setTimeout(() => {
          resolve(typeof Sk !== 'undefined');
        }, timeoutMs);

        tryPair(0);
        Promise.resolve().then(() => {});
      });
    }

    // Rularea codului Python prin motorul Skulpt
    document.getElementById('runPyBtn')?.addEventListener('click', async () => {
      const code = pyEditor.value;

      pyOutput.style.color = '#a7f3d0';
      pyOutput.textContent = '';

      if (!code.trim()) {
        pyOutput.style.color = '#fca5a5';
        pyOutput.textContent = 'Scrie codul Python în fereastră înainte de a rula.';
        return;
      }

      const skReady = await loadSkulptIfNeeded();
      if (!skReady || typeof Sk === 'undefined') {
        pyOutput.style.color = '#fca5a5';
        pyOutput.textContent = 'Eroare: motorul Python nu s-a încărcat (verifică conexiunea la internet sau extensiile de blocare scripturi).';
        return;
      }

      Sk.configure({
        output: (text) => { pyOutput.textContent += text; },
        read: (x) => {
          if (Sk.builtinFiles === undefined || Sk.builtinFiles.files[x] === undefined) {
            throw "File not found: '" + x + "'";
          }
          return Sk.builtinFiles.files[x];
        },
        inputfun: (promptText) => requestKeyboardInput(promptText),
        inputfunTakesPrompt: true,
        execLimit: null
      });

      Sk.misceval.asyncToPromise(() => Sk.importMainWithBody('<stdin>', false, code, true)).then(
        () => {},
        (err) => {
          if (stdinLiveBox) stdinLiveBox.classList.remove('active');
          pyOutput.style.color = '#fca5a5';
          pyOutput.textContent = err.toString();
        }
      );
    });
  </script>
</body>
</html>