---
const pageTitle = "Cum predăm — Model lecție: Numărarea divizorilor și testul de număr prim | Viitorul Digital";
const pageDescription = "Model complet de predare (Nivel Gimnaziu): Numărarea divizorilor și testul de număr prim — Model vizual, Flowgorithm, Pseudocod, Python și C++.";
const canonicalUrl = "https://www.viitoruldigital.ro/resurse/cum-predam/model";

const codePythonBeginners = `# Afisam mesajul explicativ si citim numarul natural nenul
print("Introduceti numarul natural:")
numar = int(input())

# Initializam contorul divizorilor cu 0
contor_divizori = 0

# Numaram toti divizorii de la 1 la numar
for divizor in range(1, numar + 1):
    if numar % divizor == 0:
        contor_divizori = contor_divizori + 1

# Afisam numarul de divizori si verificam daca este prim
print("Numar divizori:", contor_divizori)
if contor_divizori == 2:
    print("Rezultat: PRIM")
else:
    print("Rezultat: NU ESTE PRIM")`;

const codePythonFunctions = `def numara_divizori(numar):
    contor_divizori = 0
    for divizor in range(1, numar + 1):
        if numar % divizor == 0:
            contor_divizori = contor_divizori + 1
    return contor_divizori

def main():
    print("Introduceti numarul natural:")
    numar = int(input())
    total_divizori = numara_divizori(numar)
    print("Numar divizori:", total_divizori)
    if total_divizori == 2:
        print("Rezultat: PRIM")
    else:
        print("Rezultat: NU ESTE PRIM")

main()`;

const codeCppBeginners = `#include <iostream>
using namespace std;

int main() {
    // Declaram variabila pentru numarul citit si contorul de divizori
    int numar;
    int contorDivizori = 0;

    // Afisam mesajul explicativ si citim numarul natural nenul
    cout << "Introduceti numarul natural: " << endl;
    cin >> numar;

    // Parcurgem toti candidatii de la 1 la numar si numaram divizorii
    for (int divizor = 1; divizor <= numar; divizor++) {
        if (numar % divizor == 0) {
            contorDivizori = contorDivizori + 1;
        }
    }

    // Afisam numarul total de divizori
    cout << "Numar divizori: " << contorDivizori << endl;

    // Un numar este prim daca si numai daca are exact 2 divizori
    if (contorDivizori == 2) {
        cout << "Rezultat: PRIM" << endl;
    } else {
        cout << "Rezultat: NU ESTE PRIM" << endl;
    }

    return 0;
}`;
