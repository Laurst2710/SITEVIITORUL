    <script>
      const tabBtns = document.querySelectorAll('.tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');
      let activeTabId = 'py-beg';

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');
          if (!target) return;
          activeTabId = target;

          tabBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          tabPanels.forEach((p) => p.classList.remove('active'));

          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          document.getElementById(`panel-${target}`)?.classList.add('active'); }); });  const copyBtn = document.getElementById('copyCodeBtn'); copyBtn?.addEventListener('click', async () => { const codeEl = document.getElementById(`code-${activeTabId}`);
        if (!codeEl) return;
        await navigator.clipboard.writeText(codeEl.textContent || '');
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copiat!';
        setTimeout(() => { copyBtn.textContent = original; }, 1600);
      });

      const inputN = document.getElementById('inputN') as HTMLInputElement | null;
      const runBtn = document.getElementById('runAlgoBtn');
      const outputBox = document.getElementById('consoleOutput');
      const presetBtns = document.querySelectorAll('.preset-btn');

      function runAlgorithm(n: number) {
        if (!outputBox) return;
        if (!Number.isInteger(n) || n < 1) {
          outputBox.innerHTML = `<span class="err">Eroare: Te rog introdu un număr natural nenul (n ≥ 1).</span>`;
          return;
        }
        if (n > 100000) {
          outputBox.innerHTML = `<span class="err">Pentru simulatorul din pagină, folosește un număr n ≤ 100.000.</span>`;
          return;
        }

        const divizori: number[] = [];
        for (let d = 1; d <= n; d++) {
          if (n % d === 0) divizori.push(d);
        }

        const contor = divizori.length;
        const estePrim = contor === 2;
        const rezultatText = estePrim ? 'PRIM' : 'NU ESTE PRIM';
        const divizoriList = divizori.length <= 25 ? divizori.join(', ') : `${divizori.slice(0, 20).join(', ')} ... (${contor} divizori)`;

        outputBox.innerHTML = `
          <div class="console-line muted">&gt; Introduceti numarul natural: <strong>${n}</strong></div>
          <div class="console-line">&gt; Divizorii găsiți: [${divizoriList}]</div>
          <div class="console-line">&gt; <strong>Numar divizori: ${contor}</strong></div>
          <div class="console-line">&gt; <strong class="${estePrim ? 'ok' : 'warn'}">Rezultat: ${rezultatText}</strong></div>
        `;
      }

      runBtn?.addEventListener('click', () => runAlgorithm(Number(inputN?.value)));
      presetBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = Number(btn.getAttribute('data-val'));
          if (inputN) inputN.value = String(val);
          runAlgorithm(val);
        });
      });
      runAlgorithm(7);

      const btn = document.getElementById('vdAudioToggle');
      const ring = document.getElementById('vd-orbit-ring');
      const dot = document.getElementById('vd-marble-dot');
      let audioCtx: AudioContext | null = null, noiseBuffer: AudioBuffer | null = null, isEnabled = false;
      let isInside = false, lastX: number | null = null, lastY: number | null = null, currentPan = 0;
      let marbleAngle = -Math.PI / 4, distAcc = 0;

      function setupAudio() {
        if (audioCtx) return;
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        audioCtx = new AC();
        const len = audioCtx.sampleRate * 2;
        noiseBuffer = audioCtx.createBuffer(1, len, audioCtx.sampleRate);
        const data = noiseBuffer.getChannelData(0);
        for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
      }

      function playDiceTick(intensity: number) {
        if (!isEnabled || !audioCtx) return;
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;
        const panner = audioCtx.createStereoPanner();
        panner.pan.setValueAtTime(currentPan, now);

        const jitter = 0.9 + Math.random() * 0.24;
        const baseFreq = (1600 + intensity * 550) * jitter;
        const osc = audioCtx.createOscillator();
        const oscGain = audioCtx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(baseFreq, now);
        osc.frequency.exponentialRampToValueAtTime(baseFreq * 0.45, now + 0.016);

        const vol = Math.min(0.022 + intensity * 0.048, 0.075);
        oscGain.gain.setValueAtTime(0.0001, now);
        oscGain.gain.linearRampToValueAtTime(vol, now + 0.0015);
        oscGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.02);

        osc.connect(oscGain); oscGain.connect(panner); panner.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.022);

        if (noiseBuffer) {
          const src = audioCtx.createBufferSource();
          src.buffer = noiseBuffer;
          const hp = audioCtx.createBiquadFilter();
          hp.type = 'bandpass'; hp.frequency.setValueAtTime(2700 * jitter, now); hp.Q.setValueAtTime(4.2, now);
          const cg = audioCtx.createGain();
          cg.gain.setValueAtTime(vol * 0.6, now);
          cg.gain.exponentialRampToValueAtTime(0.0001, now + 0.007);
          src.connect(hp); hp.connect(cg); cg.connect(panner);
          src.start(now, Math.random() * 1.2, 0.01);
        }
      }

      function playSwoosh() {
        if (!isEnabled) return;
        setupAudio();
        if (!audioCtx || !noiseBuffer) return;
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;
        const panner = audioCtx.createStereoPanner();
        panner.pan.setValueAtTime(currentPan, now);

        const src = audioCtx.createBufferSource();
        src.buffer = noiseBuffer;
        const filter = audioCtx.createBiquadFilter();
        filter.type = 'bandpass'; filter.Q.value = 2.6;
        filter.frequency.setValueAtTime(210, now);
        filter.frequency.exponentialRampToValueAtTime(1400, now + 0.08);
        filter.frequency.exponentialRampToValueAtTime(260, now + 0.22);

        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.001, now);
        gain.gain.linearRampToValueAtTime(0.24, now + 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.23);

        src.connect(filter); filter.connect(panner); panner.connect(audioCtx.destination);
        src.start(now, Math.random() * 1.2, 0.25);
      }

      function updateDot() {
        if (!dot) return;
        const r = 17;
        dot.style.transform = `translate(${Math.cos(marbleAngle) * r}px,${Math.sin(marbleAngle) * r}px)`;
      }
      updateDot();

      function syncCursor(x: number, y: number) {
        if (!ring) return;
        if (!isInside) { isInside = true; ring.style.opacity = '1'; lastX = x; lastY = y; }
        ring.style.transform = `translate(${x - 22}px,${y - 22}px)`;
        if (lastX !== null && lastY !== null) {
          const dx = x - lastX, dy = y - lastY;
          const dist = Math.hypot(dx, dy);
          if (dist > 0.5) {
            marbleAngle += (dx >= 0 ? 1 : -1) * (dist * 0.025);
            updateDot();
            distAcc += dist;
            if (distAcc >= 34) {
              distAcc = 0;
              playDiceTick(Math.min(dist / 40, 1));
            }
          }
        }
        lastX = x; lastY = y;
        currentPan = Math.max(-1, Math.min(1, (x / window.innerWidth) * 2 - 1));
      }

      document.addEventListener('pointermove', (e) => syncCursor(e.clientX, e.clientY));
      document.addEventListener('pointerenter', (e) => syncCursor(e.clientX, e.clientY));
      document.addEventListener('pointerleave', () => {
        isInside = false; lastX = null; lastY = null;
        if (ring) ring.style.opacity = '0';
      });

      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        setupAudio();
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        isEnabled = !isEnabled;
        if (isEnabled) {
          btn.textContent = '🔊 Sunet';
          btn.classList.add('active');
          playDiceTick(0.6);
          setTimeout(() => playDiceTick(0.45), 55);
        } else {
          btn.textContent = '🔇 Sunet';
          btn.classList.remove('active');
        }
      });

      document.addEventListener('mousedown', () => {
        if (ring) ring.classList.add('click-pulse');
        playSwoosh();
      });
      document.addEventListener('mouseup', () => {
        if (ring) ring.classList.remove('click-pulse');
      });
    </script>

