        background: #23163d; border: 1px solid #4c1d95; color: #f8fafc;
        padding: 18px; border-radius: 12px; overflow-x: auto;
        font-family: 'JetBrains Mono', monospace; font-size: 0.86rem; line-height: 1.6; margin: 0;
      }
      .pseudo-block code { background: transparent; border: none; color: inherit; padding: 0; }

      .code-tabs { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 24px; }
      .tab-buttons { display: flex; flex-wrap: wrap; align-items: center; background: #f5f0ff; border-bottom: 1px solid var(--border); padding: 8px 10px; gap: 6px; }
      .tab-btn { background: transparent; border: none; color: #5b4b7a; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.88rem; padding: 8px 14px; border-radius: 8px; cursor: pointer; transition: all 0.15s ease; }
      .tab-btn:hover { color: #3b0764; background: #e9d5ff; }
      .tab-btn.active { background: #7c3aed; color: #ffffff; }

      .copy-btn { margin-left: auto; background: #ffffff; border: 1px solid #d8b4fe; color: #5b21b6; font-size: 0.82rem; font-weight: 600; padding: 6px 12px; border-radius: 7px; cursor: pointer; }
      .copy-btn:hover { background: #f3e8ff; }

      .tab-panel { display: none; background: var(--code-bg); }
      .tab-panel.active { display: block; }
      .tab-panel pre { margin: 0; padding: 18px; overflow-x: auto; font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; line-height: 1.6; color: #f8fafc; }
      .tab-panel code { background: transparent; border: none; color: inherit; padding: 0; }

      .interactive-runner { background: #faf5ff; border: 1px solid #d8b4fe; border-radius: 12px; padding: 20px; }
      .preset-buttons { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
      .preset-btn { background: #ffffff; border: 1px solid #d8b4fe; color: #4c1d95; font-size: 0.84rem; font-weight: 600; padding: 6px 12px; border-radius: 8px; cursor: pointer; }
      .preset-btn:hover { border-color: #7c3aed; background: #f3e8ff; }

      .runner-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; }
      .runner-controls input { width: 130px; padding: 8px 12px; background: #ffffff; color: #1e1035; border: 1px solid #c084fc; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 1rem; }
      .run-btn { background: linear-gradient(135deg, #7c3aed, #9333ea); color: #ffffff; border: none; font-weight: 700; font-size: 0.92rem; padding: 9px 18px; border-radius: 8px; cursor: pointer; }
      .run-btn:hover { opacity: 0.92; }

      .console-output { background: #1e1338; border: 1px solid #4c1d95; color: #f3e8ff; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; padding: 14px 16px; border-radius: 10px; line-height: 1.7; }
      .console-line.muted { color: #c4b5fd; }
      .console-output .ok { color: #4ade80; }
      .console-output .warn { color: #fda4af; }
      .console-output .err { color: #fca5a5; }

      .site-footer { border-top: 1px solid var(--border); background: #ffffff; padding: 22px 0; text-align: center; font-size: 0.9rem; color: var(--text-muted); }
    </style>
  </body>
